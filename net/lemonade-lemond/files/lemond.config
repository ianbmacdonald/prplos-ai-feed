# lemonade lemond. DISABLED and CLOSED by default.
config lemond 'main'
	option enabled '0'
	# Bind address. MUST be an IPv4 address on br-lan (anything else is refused). EMPTY = the first br-lan
	# address, waiting up to 120 s for one at boot. Never 0.0.0.0, loopback or the WAN.
	option host ''
	option port '8092'
	# LEMONADE_API_KEY: first line, >= 16 chars, a regular root-owned mode-0600 file. The service REFUSES to start without it: its API includes admin
	# routes (pull/delete/load/settings) and the client LAN is shared with Wi-Fi clients.
	option key_file '/etc/lemond/api_key'
	# config.json + user_models.json live here (conffiles; the router policy is declared in user_models.json).
	option config_dir '/etc/lemond'
	# Persistent, writable, NON-tmpfs (XNNPACK weight caches are written here). Required; /tmp and /var are refused.
	option cache_dir ''
	# Extra PATH entries for backend servers lemond launches (tflite-server; litert-lm-server is in /usr/bin).
	option server_path ''
	# cloud_providers with no key of their own get a placeholder LEMONADE_<NAME>_API_KEY (e.g. a lemond on the LAN).
	# e.g. list provider_placeholder 'LAN'
	# Model hubs (optional, plain https URLs). Unset = lemond's defaults (modelscope.cn, huggingface.co).
	# e.g. option modelscope_endpoint 'https://modelscope.ai'   (the international ModelScope site)
	# If something checks a ModelScope repository before asking lemond to pull it, point lemond at the SAME site,
	# or lemond would download from a site the check never looked at.
	#      option hf_endpoint 'https://hf-mirror.example'        (a Hugging Face mirror)
	option modelscope_endpoint ''
	option hf_endpoint ''

config firewall 'fw'
	# '0' = no rule at all (CLOSED, not 'leave whatever is there'). Rules exist only while lemond listens.
	option enabled '1'
	# TR-181 IP.Interface the rule applies to. EMPTY = detect the one that owns the bind address.
	option interface ''
	# Sources allowed to reach lemond's port: a.b.c.d or a.b.c.d/1-32 (0.0.0.0/x is refused). The running supervisor
	# re-reads this list every 10 s; a 'uci commit' may also restart the service. EMPTY = no rule: lemond is reachable only from the gateway itself.
	# e.g. list allow_src '192.168.1.10/32'   (a trusted client on the LAN)
	# Sources allowed to send lemonade discovery beacons (UDP, beacon_port) to this gateway: a relay that
	# rebroadcasts a LAN AI host's beacon onto this LAN (a broadcast does not cross a router). Same format and
	# lifetime as allow_src. EMPTY = no rule.
	# e.g. list beacon_src '192.168.1.20/32'   (a beacon relay)
	option beacon_port '13305'
