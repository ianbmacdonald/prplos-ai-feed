#!/bin/sh /etc/rc.common
# procd service for lemonade lemond.
# The instance is /usr/libexec/lemond-run, a small SUPERVISOR that owns both lemond and its firewall rule:
# it binds ONLY a br-lan IPv4 address, validates the API key file, opens the source-restricted TR-181 rule
# only once lemond is listening, re-checks it every 10 s, and removes it on ANY exit. stop_service also
# closes the rule first (belt and braces), and marks 'stopping' so no in-flight add can reopen it.
# ACCEPTED residual, needing an attacker who is already the service user: it can read the API key from lemond's
# environment.
# lemond itself, and every runtime server it starts, run as the unprivileged user in 'option user' (default
# lemond); the supervisor keeps root only for the key file and the firewall rule. The paths lemond writes are
# handed to that user here, and only the device nodes listed in 'list device' (accelerators) are opened to it.

USE_PROCD=1
START=96
STOP=09
STOPPING=/var/run/lemond.stopping

start_service() {
	config_load lemond
	local enabled host port key_file config_dir cache_dir server_path ph user models_dir
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get host main host ''
	config_get port main port '8092'
	config_get key_file main key_file '/etc/lemond/api_key'
	config_get config_dir main config_dir '/etc/lemond'
	config_get cache_dir main cache_dir ''
	config_get server_path main server_path ''
	config_get user main user 'lemond'
	config_get models_dir main models_dir ''
	# Model hubs (optional): a ModelScope site other than lemond's default modelscope.cn (e.g. the international
	# https://modelscope.ai), and a Hugging Face mirror. Plain https URLs only; anything else refuses to start.
	local ms_endpoint hf_endpoint env
	config_get ms_endpoint main modelscope_endpoint ''
	config_get hf_endpoint main hf_endpoint ''
	ph=; add_ph() { ph="$ph $1"; }
	config_list_foreach main provider_placeholder add_ph

	err() { logger -t lemond -p daemon.err "$1 - not starting"; return 1; }
	[ -f "$key_file" ] || { err "no API key at $key_file"; return 1; }
	[ -f "$config_dir/config.json" ] || { err "no $config_dir/config.json"; return 1; }
	case "$cache_dir" in
		'') err "option cache_dir is required (persistent, non-tmpfs)"; return 1 ;;
		/tmp|/tmp/*|/var|/var/*) err "cache_dir $cache_dir is on tmpfs (weight caches would sit in RAM)"; return 1 ;;
	esac
	mkdir -p "$cache_dir" || { err "cannot create cache_dir $cache_dir"; return 1; }
	case "$user" in ''|*[!a-z0-9_-]*) err "user '$user' is not a plain user name"; return 1 ;; esac
	if [ "$user" != root ]; then
		local uid c
		uid=$(awk -F: -v u="$user" '$1 == u {print $3}' /etc/passwd)
		[ -n "$uid" ] || { err "user $user does not exist"; return 1; }
		[ "$uid" != 0 ] || { err "user $user has uid 0 (use 'root' to run privileged, deliberately)"; return 1; }
		[ "$port" -ge 1024 ] 2>/dev/null || { err "port $port is below 1024: an unprivileged user cannot bind it"; return 1; }
		grep -q "^$user:" /etc/group || { err "group $user does not exist"; return 1; }   # ujail -G
		# What lemond writes: the cache (weight caches, HOME), the models directory (pulls land there) and
		# config.json / user_models.json (config set, pull registration). Every path handed over comes from THIS uci
		# file (root-owned), never from lemond's own config.json, which lemond can rewrite (a models_dir
		# of /etc would have had root chown /etc to lemond). A path must be a real directory under /mnt or /srv and
		# not a symlink. The recursive handover runs ONCE (when root still owns it); after that only the top level
		# is touched, and always with -h: busybox chown -R follows symlinks (measured), and the contents are lemond's.
		handover() {
			local d=${1%/} r
			[ -n "$d" ] || return 0
			case "$d" in /mnt/?*|/srv/?*) [ -e "$d" ] || [ -L "$d" ] || mkdir -p "$d" ;; esac   # first start: create it, only below the allowed roots
			[ -d "$d" ] && [ ! -L "$d" ] || { err "$2 $d is not a real directory"; return 1; }
			# The CANONICAL path must equal the configured one: no component may be a symlink (a leaf check misses a
			# link higher up, and test -L misses one behind a trailing slash - measured).
			r=$(readlink -f "$d") && [ "$r" = "$d" ] || { err "$2 $d is not a canonical path (a component is a symlink)"; return 1; }
			case "$r" in /mnt/?*|/srv/?*) ;; *) err "$2 $d must be a directory below /mnt or /srv"; return 1 ;; esac
			if [ "$(ls -ldn "$r" | awk '{print $3}')" = "$uid" ]; then chown -h "$user:$user" "$r"; else chown -Rh "$user:$user" "$r"; fi || { err "cannot hand $d to $user (does this filesystem support ownership?)"; return 1; }
			logger -t lemond -p daemon.notice "$2 $r handed to $user"
		}
		# config_dir must itself be a real, canonical directory before root changes it. lemond owns
		# config.json / user_models.json and can swap either for a symlink: refuse that; root never READS them here
		# (a check-then-read could be raced), it only chowns them with -h.
		c=${config_dir%/}
		[ -d "$c" ] && [ ! -L "$c" ] && [ "$(readlink -f "$c")" = "$c" ] || { err "config_dir $config_dir is not a canonical directory"; return 1; }
		for f in config.json user_models.json; do
			[ -L "$config_dir/$f" ] && { err "$config_dir/$f is a symlink"; return 1; }
		done
		handover "$cache_dir" cache_dir || return 1
		handover "$models_dir" models_dir || return 1
		# The config directory stays root-owned with the sticky bit: lemond can rewrite its own two files but never
		# replace the root-only key. A file that is a symlink is refused (a swapped-in link would steer root's chown).
		chown root:"$user" "$config_dir" && chmod 1775 "$config_dir"
		for f in config.json user_models.json; do [ -f "$config_dir/$f" ] && chown -h "$user:$user" "$config_dir/$f"; done
		# Accelerator device nodes (e.g. /dev/accel0, /dev/dri/renderD128): opened to the service's PRIMARY group (set by
		# ujail -G; no supplementary groups are needed), nothing else. Re-applied at every start; a node recreated
		# while lemond runs (replug, late module load) needs a restart.
		add_dev() {
			for n in "$1"; do
				if [ -c "$n" ] && [ ! -L "$n" ] && chgrp "$user" "$n" && chmod g+rw "$n"; then logger -t lemond -p daemon.notice "device $n opened to $user"
				else logger -t lemond -p daemon.warning "device $n is not a character device (or could not be opened): the runtime will not see it"; fi
			done
		}
		config_list_foreach main device add_dev
	fi
	env=
	for kv in "MODELSCOPE_ENDPOINT=$ms_endpoint" "HF_ENDPOINT=$hf_endpoint"; do
		v=${kv#*=}; [ -n "$v" ] || continue
		case "$v" in https://*/*|*[!A-Za-z0-9.:/_-]*|https://) err "${kv%%=*} '$v' is not a plain https URL"; return 1 ;; https://*) ;; *) err "${kv%%=*} '$v' is not a plain https URL"; return 1 ;; esac
		env="$env $kv"
	done

	rm -f "$STOPPING"
	procd_open_instance
	procd_set_param command /usr/libexec/lemond-run "$key_file" "${host:-auto}" "$port" "$cache_dir" "$config_dir" "$server_path" "$user" $ph
	[ -n "$env" ] && procd_set_param env $env
	procd_set_param respawn
	# procd records this but does not apply it on this image (measured 2026-09-30); lemond-run enforces it for lemond
	# and its runtimes through ujail -c (plus an empty capability bounding set).
	procd_set_param no_new_privs 1
	procd_set_param term_timeout 30      # the supervisor's exit trap closes the port before lemond is stopped
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	touch "$STOPPING"
	/usr/libexec/lemond-fw del
}

service_triggers() {
	procd_add_reload_trigger "lemond"
}
