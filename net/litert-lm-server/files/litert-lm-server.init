#!/bin/sh /etc/rc.common
# procd init for litert-lm-server (LiteRT-LM OpenAI-compatible inference server).
#
# Flags come straight from the source (server.cpp main()): --model <path> (REQUIRED),
# --port N (binary default 8080; the uci default is 8091), --host H (default 0.0.0.0), --model-id ID,
# and from v0.2.0 --trim-after-request / --cache-dir / --chat-template-kwargs (uci options). CPU backend, one
# model per process, serialized inference (no thread knob). Endpoints: /health,
# /v1/models, /v1/chat/completions.
#
# Disabled by default (enabled '0' in /etc/config/litert-lm-server) because it needs a
# .litertlm model present first. The model goes on PERSISTENT writable
# storage (NOT /var — tmpfs on OpenWrt); the model path is the uci 'model' option.

USE_PROCD=1
# Start late — after the network + LCM stack are up.
START=95
STOP=10

start_service() {
	config_load litert-lm-server

	local enabled host port model model_id trim cache_dir ctk mnt
	config_get_bool enabled main enabled 0
	config_get host     main host     '127.0.0.1'
	config_get port     main port     '8091'
	config_get model    main model    ''
	config_get model_id main model_id ''
	config_get_bool trim main trim_after_request 1
	config_get cache_dir main cache_dir ''
	config_get ctk main chat_template_kwargs ''
	config_get mnt main max_num_tokens ''

	[ "$enabled" = "1" ] || return 0

	if [ -z "$model" ] || [ ! -f "$model" ]; then
		echo "litert-lm-server: model not found ('$model') — set option model in /etc/config/litert-lm-server" >&2
		return 1
	fi

	procd_open_instance
	procd_set_param command /usr/bin/litert-lm-server --model "$model" --host "$host" --port "$port"
	[ -n "$model_id" ] && procd_append_param command --model-id "$model_id"
	[ "$trim" = "1" ] && procd_append_param command --trim-after-request
	[ -n "$cache_dir" ] && procd_append_param command --cache-dir "$cache_dir"
	[ -n "$ctk" ] && procd_append_param command --chat-template-kwargs "$ctk"
	[ -n "$mnt" ] && procd_append_param command --max-num-tokens "$mnt"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "litert-lm-server"
}
