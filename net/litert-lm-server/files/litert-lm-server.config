config litert-lm-server 'main'
	# Disabled until a .litertlm model is provisioned.
	option enabled '0'
	# Bind localhost by default: Lemonade launches this as a LOCAL subprocess backend.
	# (The binary itself defaults to 0.0.0.0; we pin 127.0.0.1 here for the gateway.)
	option host '127.0.0.1'
	# NOT 8080 (the binary's default): LCM container apps sharing the host network commonly listen there.
	option port '8091'
	# Path to the .litertlm model + its ~339 MB XNNPACK cache (written next to it) => ~1 GB, on
	# WRITABLE storage. Standard prpl model tiering: the recipe + certified/base models live on
	# flash; larger model weights go on the device's writable DATA tier (eMMC or USB). The only
	# thing to avoid is /var (tmpfs/RAM on OpenWrt) and the small NAND overlay — point this at the
	# device's data mount (for example a USB key on development boards, eMMC on production devices).
	# Hard requirements: persistent, writable, non-tmpfs, ~1 GB.
	#
	# *** NEVER SHARE ONE MODEL DIR ACROSS ARCHITECTURES ***: the
	# XNNPACK cache is written NEXT TO the model and its cache key is MODEL-CONTENT-based, NOT
	# arch-qualified — an aarch64 run was observed writing its cache under the IDENTICAL key an
	# x86 run had used. A dir shared over NFS/USB between an x86 box and the gateway therefore
	# silently serves one arch's compiled cache to the other. Give each architecture its own dir.
	option model '/mnt/litert-lm/models/model.litertlm'
	# Optional OpenAI 'model' id advertised at /v1/models (defaults to the model filename).
	option model_id ''
	# trim_after_request returns freed heap to the OS after each request (glibc bundle: qwen3's growth between
	# identical chats fell from +352 MiB to about +8 MiB). The musl build accepts it and does not need it.
	option trim_after_request '1'
	# XNNPACK/weight cache location (default: next to the model). Set it when the model dir is
	# read-only. Persistent, non-tmpfs, and never shared across architectures (see above).
	option cache_dir ''
	# Default chat-template variables, e.g. '{"enable_thinking":false}' to stop qwen3 'thinking'.
	option chat_template_kwargs ''
	# Context/KV cap (prompt + output tokens). The engine REFUSES a longer prompt at once (HTTP 500,
	# server stays up) instead of thrashing into memory pressure. It is PER MODEL, so there is no global
	# default. Measured on a 2 GB prplOS gateway:
	#   Gemma3-1B int4   -> 1536   (1.5k context fits under a 1.4GB cap; 3.2k does not)
	#   Qwen2-0.5B       -> 4096   (flat ~360MiB even at ~3k tokens)
	# NOTE: when lemonade (lemond) launches this server, lemond's own recipe args apply, not these uci options.
	option max_num_tokens ''
