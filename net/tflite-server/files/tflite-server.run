#!/bin/sh
# PATH wrapper for the tflite-server prebuilt musl bundle, installed under /usr/lib/tflite-server. It execs the real path so the
# binary's $ORIGIN (RUNPATH) is its own bin/ directory, and the process keeps this PID (lemond stops it by PID).
BIN=/usr/lib/tflite-server/bin/tflite-server
[ -x "$BIN" ] || { echo "tflite-server: server binary missing or not executable: $BIN" >&2; exit 127; }
exec "$BIN" "$@"
